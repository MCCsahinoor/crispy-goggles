ng the other phone...","phone.joinHint":"If Android asks to connect to a DIRECT-FL network, tap Connect.","phone.wifiOff":"Wi-Fi is off. Turn it on to connect \u2014 it doesn't need to join any network.","phone.turnOnWifi":"Turn on Wi-Fi","phone.joinFailed":"Could not join the other phone. Stay near it and try the QR code again.","phone.locationRequired":"Location permission is required to start a hotspot or Wi-Fi Direct.","phone.transportHotspot":"This phone is sharing a local hotspot. The other phone scans the QR code and joins it.","phone.transportDirect":"Wi-Fi Direct is on. The other phone scans the QR code to connect directly.","phone.modeDirect":"This phone creates its own private Wi-Fi group (DIRECT-FL-\u2026) and the other phone joins it. No router, internet or mobile data needed. Nearby discovery uses this.","phone.modeHotspot":"This phone turns on a temporary, app-only hotspot. The other phone joins it by scanning the QR code, which carries the name and password. Works without internet; use it if Wi-Fi Direct is not available.","phone.modeLan":"Nothing is created: both phones must already be on the same Wi-Fi network (a home router, or one phone's regular hotspot). Quickest when that network exists, but office and public Wi-Fi often block phone-to-phone traffic.","phone.nearbyTitle":"Nearby phones","phone.nearbySearching":"Looking for nearby phones. On the other phone, open Filora and tap Receive.","phone.nearbyOff":"Nearby search is unavailable. Turn on Wi-Fi and allow Nearby devices, or scan the QR code.","phone.viaDirect":"Wi-Fi Direct \xb7 tap to send","phone.viaLan":"Same Wi-Fi \xb7 tap to send","phone.scanFallback":"Phone not listed? Scan the QR code on the receiving phone.","phone.discoverable":"Nearby Filora phones can see this phone as {name}.","phone.hotspotOn":"Hotspot {name} is on. The other phone joins by scanning the QR code; your Wi-Fi may show as off meanwhile.","phone.you":"You","phone.yourDevice":"Your device is \"{name}\"","phone.profileTitle":"Your profile","phone.profileName":"Profile name","phone.profileHint":"Letters, numbers, dots and underscores \xb7 2\u201316 characters","phone.profileSeen":"Other phones see this name and emoji when you share.","phone.newName":"New name","phone.pickEmoji":"Pick an emoji","phone.editProfile":"Edit profile","phone.tapToSend":"Tap a phone to send","phone.scanQrShort":"Scan QR","phone.manualShort":"Enter code","phone.details":"Connection details","phone.otherPhone":"Other phone","picker.tabPhotos":"Photos","picker.tabVideos":"Videos","picker.tabMusic":"Music","picker.tabFiles":"Files","picker.photos":"Photos","picker.albums":"Albums","picker.videos":"Videos","picker.songs":"Songs","picker.folders":"Folders","picker.search":"Search","picker.selectAll":"Select All","picker.selected":"{count} selected","picker.today":"Today","picker.yesterday":"Yesterday","picker.undated":"No date","picker.itemCount":"{count} items","picker.empty":"Nothing here yet.","picker.noResults":"No matches for \"{query}\".","picker.loadFailed":"Could not read the media library.","picker.permissionTitle":"Allow access to your photos, videos and music","picker.permissionBody":"Filora only reads the files you pick, to send them to the other phone.","picker.allow":"Allow access","picker.openSettings":"Open settings","picker.limited":"Only some items are shared with Filora.","picker.manage":"Manage","picker.browse":"Browse files","picker.browseHint":"Documents, archives and other files on this phone.","picker.filesEmpty":"No files picked yet. Tap Browse files to add some.","picker.clearAll":"Clear all","picker.tooMany":"You can send up to {max} files at once.","picker.skipped":"{count} files could not be read and were skipped.","picker.preparing":"Preparing files...","picker.tabApps":"Apps","picker.installed":"Installed","picker.packages":"Packages","picker.newApps":"New","picker.apps":"Apps","picker.browseApk":"Browse APK files","picker.browseApkHint":"APK, APKS and XAPK files saved on this phone.","picker.apksEmpty":"No APK files picked yet. Tap Browse APK files to add some.","picker.appsLoadFailed":"Could not list installed apps.","picker.apkFiles":"APK files","picker.storageTitle":"Let Filora see all files","picker.storageBody":"Android hides other apps' downloads unless Filora has \"All files access\". Filora only uses it to find APK files you can send.","picker.storageAllow":"Allow in Settings","picker.scanning":"Looking for APK files...","picker.scanFailed":"Could not scan storage.","picker.noApks":"No APK files found on this phone.","phone.transportLan":"Using the current Wi-Fi. Both phones must already be on this network.","connect.unlockFiles":"Unlock files","connect.useAnotherLink":"Use another link","connect.loadingFiles":"Loading files...","connect.connecting":"Connecting...","connect.unlocking":"Unlocking...","connect.unlockCheckPassword":"Could not unlock. Check the password and try again.","connect.somethingWrong":"Something went wrong.","connect.couldNotConnect":"Could not connect.","connect.pcModeMismatch":"PC is in {mode} mode. Switch the app to match Filora on your PC.","connect.pasteLocalHint":"Paste a local link like http://192.168.137.1:8765/s/9GEL16siviA or scan Share QR.","connect.pasteGlobalHint":"Paste a valid Filora global link or scan the Share QR.","connect.unlockFailed":"Unlock failed.","connect.downloadFailed":"Download failed.","connect.savedPublic":"Saved to Documents/Filora/{file}","connect.savedApp":"Saved to app Filora folder/{file}","connect.invalidWifiQr":"Invalid Wi-Fi QR format. Scanned: {data}","connect.joinWifi":"Join \"{ssid}\" in phone Wi-Fi settings, then scan the Share QR.","connect.allowLocationInSettings":"Allow location for Filora in App permissions, then try again.","connect.locationStillOff":"Location is still off. Turn it on to join Wi-Fi automatically.","connect.cameraRequired":"Camera permission is required to scan QR codes.","connect.nothingToPaste":"Nothing to paste from clipboard.","connect.enablingWifi":"Enabling Wi-Fi...","connect.connectingTo":"Connecting to {ssid}...","connect.connectedTo":"Connected to {ssid}! Now scan Share QR.","connect.connectionInitiated":"Connection initiated. Check Wi-Fi settings if not connected.","connect.connectionFailed":"Connection failed","connect.wifiError":"Wi-Fi error: {msg}. Opening settings...","scan.wifiTitle":"Scan Wi-Fi QR from Filora Desktop","scan.localShareTitle":"Scan local Share QR from Filora Desktop","scan.shareTitle":"Scan Filora Share QR","global.title":"Global link mode","global.body":"Use this when Filora Desktop is in Global link mode. Phone can use mobile data.","scanCard.shareTitle":"Scan Share QR","global.scanShareSubtitle":"Scan the QR code from Filora Desktop","local.title":"Local network mode","local.body":"Use when Filora Desktop is in Local network mode. Join the PC hotspot or same Wi-Fi.","local.step1":"Step 1 \u2014 Join PC network","local.scanWifiTitle":"Scan Wi-Fi QR","local.scanWifiSubtitle":"Scan the QR to join PC network.","local.networkConnected":"{ssid} network connected","local.connectToSsid":"Connect to {ssid}","local.step2":"Step 2 \u2014 Connect to PC","local.scanShareSubtitle":"Scan the QR from Filora Desktop.","local.passwordNone":"(none)","files.title":"Shared files","files.available_one":"{count} file available","files.available_other":"{count} files available","files.emptyTitle":"No files yet","files.emptyBody":"Add files on the PC, then tap Refresh.","files.disconnect":"Disconnect","send.title":"Send to PC","send.hero":"Select files on your phone, generate a QR code, then scan it from Filora Desktop to upload.","send.step1":"Step 1 \xb7 Select files","send.chooseFiles":"Choose files","send.chooseFilesSubtitle":"Photos, documents, videos, and more","send.selected":"Selected files ({count})","send.addMore":"Add more files","send.step2":"Step 2 \xb7 Generate QR","send.generateQr":"Generate QR","send.step3":"Step 3 \xb7 Scan from Filora Desktop","send.zoomQr":"Zoom QR code","send.tapToZoom":"Tap QR to zoom","send.qrHint":"On your PC, open Filora Desktop \u2192 Receive from phone \u2192 Scan this QR. Your phone will connect and upload automatically.","send.noCamera":"No camera? Copy this code","send.copyCodeLabel":"Copy send code","send.pasteHint":"Paste it in Filora Desktop \u2192 Receive from phone.","send.waiting_one":"{count} file ready \u2014 scan this QR on Filora Desktop","send.waiting_other":"{count} files ready \u2014 scan this QR on Filora Desktop","send.connecting_one":"Desktop scanned \u2014 uploading {count} file\u2026","send.connecting_other":"Desktop scanned \u2014 uploading {count} files\u2026","send.uploading":"Uploading {current} of {total}","send.uploadingFile":"Uploading {current} of {total}: {file}","send.doneTitle":"Sent to PC","send.doneBody_one":"{count} file uploaded successfully.","send.doneBody_other":"{count} files uploaded successfully.","send.sendMore":"Send more files","send.tapToClose":"Tap to close","send.toastSent_one":"Sent {count} file to your PC.","send.toastSent_other":"Sent {count} files to your PC.","send.couldNotPick":"Could not pick files.","send.failed":"Send failed.","send.copied":"Copied. Paste it in Filora Desktop \u2192 Receive from phone.","send.couldNotCopy":"Could not copy. Long-press the code to copy it.","history.empty":"No history yet","history.emptyBody":"Recent PC connections will show up here so you can reconnect faster.","history.justNow":"Just now","history.minutesAgo":"{count}m ago","history.hoursAgo":"{count}h ago","location.permTitle":"Allow location access","location.permBody":"Filora uses location only to join your PC's Wi-Fi. It does not track you.","location.permAction":"Allow location","location.offTitle":"Turn on location","location.offBody":"Android needs location turned on so Filora can join your PC's Wi-Fi. Filora does not track you.","location.offAction":"Turn on location","location.opening":"Opening settings\u2026","location.connectManually":"Connect manually","location.dismiss":"Dismiss location prompt","howto.title":"How to use Filora","howto.intro":"Follow these steps to share files between your Windows PC and this phone. No account needed.","howto.close":"Close how to use","howto.step1.title":"Install both apps","howto.step1.body":"Filora Mobile is the phone companion for Filora on Windows. No account or USB cable is required.","howto.step1.b1":"Keep this Android app installed.","howto.step1.b2":"On your PC, download Filora for Windows, extract the archive, and run Filora.exe.","howto.step2.title":"Choose a sharing mode on the PC","howto.step2.body":"Open Filora.exe and pick the same mode you will use on this phone.","howto.step2.b1":"Global link \u2014 best when the phone is on mobile data or a different network. The PC creates a temporary public HTTPS link.","howto.step2.b2":"Local network \u2014 best when the phone and PC are on the same Wi-Fi or the PC hotspot. Transfers stay on your network.","howto.step3.title":"Add files on your Windows PC","howto.step3.body":"In Filora Desktop, add the photos, documents, videos, or archives you want to share. Sharing stays active until you stop it on the PC.","howto.step4.title":"Receive files on this phone","howto.step4.body":"Open the Received tab and match the PC mode.","howto.step4.b1":"Global link: paste the share URL, or tap Scan Share QR, then Connect. Mobile data works.","howto.step4.b2":"Local network: tap Scan Wi-Fi QR and join the PC network, then scan the Share QR or paste the local link (for example http://192.168.x.x:8765/s/...), then Connect.","howto.step4.b3":"If the PC owner set a password, enter it when asked.","howto.step5.title":"Save files to your phone","howto.step5.body":"Browse the shared list and tap Save on any file. Downloads go into a Filora folder on this device, typically Documents/Filora. You can change the folder in Settings.","howto.step6.title":"Send files from phone to PC","howto.step6.body":"Use the Send tab when you want the opposite direction.","howto.step6.b1":"Pick one or more files on your phone.","howto.step6.b2":"Show the QR code in this app.","howto.step6.b3":"On the PC, open Filora Desktop \u2192 Receive from phone \u2192 scan this QR.","howto.step6.b4":"If the PC has no camera, tap Copy under the QR and paste the code in Filora Desktop.","howto.step6.b5":"Phone and PC must be on the same Wi-Fi or the PC hotspot.","howto.linksHeading":"Helpful links","howto.link.website.title":"Official website","howto.link.website.subtitle":"Features, FAQ, and how Filora works","howto.link.windows.title":"Download for Windows","howto.link.windows.subtitle":"Get Filora.exe for Windows 10/11","howto.link.privacy.title":"Privacy policy","howto.link.privacy.subtitle":"How Filora handles your files","settings.general":"General","settings.howTo":"How to use","settings.howToSubtitle":"Step-by-step instructions","settings.language":"Language","settings.theme":"Theme","settings.theme.system":"System","settings.theme.light":"Light","settings.theme.dark":"Dark","settings.storage":"Storage","settings.downloadFolder":"Download folder","settings.clearCache":"Clear cache","settings.clearCacheSubtitle":"Remove temporary files","settings.permissions":"Permissions","settings.permissionsNone":"Camera, location, and storage","settings.permissionsAll":"All required permissions allowed","settings.permissionsSome":"{granted} of {total} allowed","settings.allowed":"Allowed","settings.notAllowed":"Not allowed","settings.openSystemSettings":"Open system settings","settings.openSystemSettingsSubtitle":"Change permissions if the prompt is blocked","settings.about":"About","settings.aboutTagline":"Fast & private local file transfer","settings.website":"Official website","settings.privacy":"Privacy policy","settings.checkUpdates":"Check for updates","settings.checkUpdatesSubtitle":"See if a new version is available.","settings.getDesktop":"Get Filora Desktop","settings.getDesktopSubtitle":"Download the desktop app for Windows","settings.shareApp":"Share app","settings.shareAppSubtitle":"Send a link to Filora Mobile","settings.shareAppMessage":"Transfer files between your PC and phone with Filora \u2014 no account needed.\n{url}","settings.version":"Version","settings.folderIosBody":"Files are saved to the Filora folder in this app.","settings.folderIosPath":"Filora (app folder)","settings.couldNotChangeFolder":"Could not change folder.","settings.clearCacheConfirm":"Remove temporary files from this app?","settings.clear":"Clear","settings.cacheCleared":"Cache cleared","settings.cacheClearedBody":"Temporary files were removed.","settings.couldNotClearCache":"Could not clear cache.","settings.couldNotRequestPermission":"Could not request permission.","settings.couldNotRequestPermissions":"Could not request permissions.","settings.allRequiredAllowed":"All required permissions are allowed.","settings.someRequiredAllowed":"{granted} of {total} required permissions are allowed.","settings.aboutP1":"Filora is the phone companion for Filora on Windows. Connect to a share on your PC and save files to your phone \u2014 no account required.","settings.aboutP2":"Use Global link when the PC is sharing over the internet. Paste the share URL or scan the Share QR. Mobile data works.","settings.aboutP3":"Use Local network on the same Wi-Fi or PC hotspot. Scan the Wi-Fi QR to join the PC network, then scan the Share QR or paste the local link.","settings.aboutP4":"If the share is password-protected, unlock it on your phone, browse the file list, and save files to your Filora folder. Light and dark themes, connection history, and permission controls are in Settings.","settings.aboutP5":"Requires Filora running on your Windows PC with files added to the share.","settings.privacyBody":"Filora connects directly to Filora on your PC. It does not require an account. Share links you paste and files you download stay on this device unless you share them yourself. The app shows ads from Google AdMob.","settings.closeLanguage":"Close language picker","perm.camera.title":"Camera","perm.camera.subtitle":"Scan Share QR and Wi-Fi QR codes","perm.location.title":"Location & nearby Wi-Fi","perm.location.subtitle":"Join the PC hotspot or Wi-Fi network","perm.storage.title":"Storage","perm.storage.subtitle":"Save downloaded files","perm.locationDialogTitle":"Location Permission","perm.locationDialogMessage":"Filora needs location access to connect to Wi-Fi networks.","perm.needed":"Permission needed","perm.cameraOff":"Camera permission is turned off. Enable it in system settings.","perm.storageOff":"Storage permission is turned off. Enable it in system settings.","save.storageUnavailable":"Device storage is not available.","save.permissionTimeout":"Storage permission request timed out.","save.folderTimeoutChange":"Folder access timed out. Try again and pick Documents \u2192 Filora.","save.folderTimeoutSave":"Folder access timed out. Try Save again and pick Documents \u2192 Filora.","save.allowFolderTitle":"Allow Filora folder","save.allowFolderBody":"Tap Allow for storage. If a folder screen opens, open Documents (not Download), then tap USE THIS FOLDER. Filora will be created automatically.","save.downloadTimeout":"Download timed out. Check your connection and try again.","save.downloadHttp":"Download failed (HTTP {status}).","save.downloadRedirected":"Download was redirected. Please try scanning the QR code again.","save.couldNotSave":"The file could not be saved to the Filora folder.","save.emptyFile":"Download returned empty file. Check connection and try again.","net.unreachableLocal":"Could not reach Filora. The link works in your browser but the app needs a rebuild to allow local HTTP. Run: npm run android. Also check Filora.exe is running and Windows Firewall allows port 8765.","net.unreachableGlobal":"Could not reach Filora. Use a fresh Global link from Filora.exe (Restart sharing if the old link expired).","net.timeout":"Timed out reaching Filora. Check that the PC app is still running.","net.sessionNotFound":"Session not found.","net.cloudflareBlocked":"Cloudflare blocked the app request. Wait a few seconds, then try the link again.","net.couldNotLoadFiles":"Could not load files from Filora.","net.enterPassword":"Enter the access password from Filora on your PC.","net.wrongPassword":"Wrong password.","net.couldNotUnlock":"Could not unlock Filora session.","net.modeGlobalLink":"This is a global link. Use Global link mode, or scan the local Share QR from Filora.","net.modeLocalLink":"This is a local network link. Switch to Local network mode on the app and PC.","sendErr.cancelled":"Send cancelled.","sendErr.noResponse":"Desktop did not respond. Make sure the phone and PC are on the same Wi-Fi (or this PC's hotspot) and that Windows Firewall allows Filora.","sendErr.uploadFailedStatus":"Upload failed ({status}).","sendErr.uploadFailed":"Upload failed.","sendErr.couldNotRead":"Could not read {name} on this phone. Pick the file again.","sendErr.couldNotUpload":"Could not upload {name}.","sendErr.couldNotListen":"Could not listen.","sendErr.couldNotListenDesktop":"Could not listen for the desktop connection.","update.availableTitle":"Update available","update.availableVersion":"Version {store} is available. You're on {current}.","update.availableGeneric":"A new version of Filora is available with improvements and bug fixes.","update.notNow":"Not now","update.action":"Update","update.failedTitle":"Update failed","update.couldNotOpen":"Could not open the update. Try again from the Play Store or App Store.","update.checkTitle":"Check for updates","update.devBuild":"You're using version {current}. Update checks run in release builds installed from the store.","update.usingVersion":"You're using version {current}.","update.latest":"You're on the latest version ({current}).","update.couldNotStart":"Could not start the update. Try again from Google Play.","update.couldNotCheckIos":"Could not check the App Store. Add AppStoreID in app.json when the app is published.","update.couldNotCheckAndroid":"Could not check for updates. Make sure the app is installed from Google Play."}},633,[]);
