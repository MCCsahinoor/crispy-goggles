940 Wi-Fi","phone.joining":"\u0926\u0942\u0938\u0930\u0947 \u092b\u093c\u094b\u0928 \u0938\u0947 \u091c\u0941\u0921\u093c \u0930\u0939\u0947 \u0939\u0948\u0902...","phone.joinHint":"\u0905\u0917\u0930 Android \u0915\u093f\u0938\u0940 DIRECT-FL \u0928\u0947\u091f\u0935\u0930\u094d\u0915 \u0938\u0947 \u091c\u0941\u0921\u093c\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092a\u0942\u091b\u0947, \u0924\u094b Connect \u092a\u0930 \u091f\u0948\u092a \u0915\u0930\u0947\u0902\u0964","phone.wifiOff":"Wi-Fi \u092c\u0902\u0926 \u0939\u0948\u0964 \u091c\u0941\u0921\u093c\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0907\u0938\u0947 \u091a\u093e\u0932\u0942 \u0915\u0930\u0947\u0902 \u2014 \u0915\u093f\u0938\u0940 \u0928\u0947\u091f\u0935\u0930\u094d\u0915 \u0938\u0947 \u091c\u0941\u0921\u093c\u0928\u093e \u091c\u093c\u0930\u0942\u0930\u0940 \u0928\u0939\u0940\u0902\u0964","phone.turnOnWifi":"Wi-Fi \u091a\u093e\u0932\u0942 \u0915\u0930\u0947\u0902","phone.joinFailed":"\u0926\u0942\u0938\u0930\u0947 \u092b\u093c\u094b\u0928 \u0938\u0947 \u0928\u0939\u0940\u0902 \u091c\u0941\u0921\u093c \u0938\u0915\u0947\u0964 \u092a\u093e\u0938 \u0930\u0939\u0947\u0902 \u0914\u0930 QR \u0915\u094b\u0921 \u092b\u093f\u0930 \u0938\u0947 \u0938\u094d\u0915\u0948\u0928 \u0915\u0930\u0947\u0902\u0964","phone.locationRequired":"\u0939\u0949\u091f\u0938\u094d\u092a\u0949\u091f \u092f\u093e Wi-Fi Direct \u0915\u0947 \u0932\u093f\u090f \u0932\u094b\u0915\u0947\u0936\u0928 \u0915\u0940 \u0905\u0928\u0941\u092e\u0924\u093f \u091c\u093c\u0930\u0942\u0930\u0940 \u0939\u0948\u0964","phone.transportHotspot":"\u092f\u0939 \u092b\u093c\u094b\u0928 \u0932\u094b\u0915\u0932 \u0939\u0949\u091f\u0938\u094d\u092a\u0949\u091f \u0936\u0947\u092f\u0930 \u0915\u0930 \u0930\u0939\u093e \u0939\u0948\u0964 \u0926\u0942\u0938\u0930\u093e \u092b\u093c\u094b\u0928 QR \u0915\u094b\u0921 \u0938\u094d\u0915\u0948\u0928 \u0915\u0930\u0915\u0947 \u091c\u0941\u0921\u093c\u0924\u093e \u0939\u0948\u0964","phone.transportDirect":"Wi-Fi Direct \u091a\u093e\u0932\u0942 \u0939\u0948\u0964 \u0926\u0942\u0938\u0930\u093e \u092b\u093c\u094b\u0928 QR \u0915\u094b\u0921 \u0938\u094d\u0915\u0948\u0928 \u0915\u0930\u0915\u0947 \u0938\u0940\u0927\u0947 \u091c\u0941\u0921\u093c\u0924\u093e \u0939\u0948\u0964","phone.modeDirect":"\u092f\u0939 \u092b\u093c\u094b\u0928 \u0905\u092a\u0928\u093e \u0928\u093f\u091c\u0940 Wi-Fi \u0917\u094d\u0930\u0941\u092a (DIRECT-FL-\u2026) \u092c\u0928\u093e\u0924\u093e \u0939\u0948 \u0914\u0930 \u0926\u0942\u0938\u0930\u093e \u092b\u093c\u094b\u0928 \u0909\u0938\u0938\u0947 \u091c\u0941\u0921\u093c\u0924\u093e \u0939\u0948\u0964 \u0930\u093e\u0909\u091f\u0930, \u0907\u0902\u091f\u0930\u0928\u0947\u091f \u092f\u093e \u092e\u094b\u092c\u093e\u0907\u0932 \u0921\u0947\u091f\u093e \u0915\u0940 \u091c\u093c\u0930\u0942\u0930\u0924 \u0928\u0939\u0940\u0902\u0964 \u0906\u0938-\u092a\u093e\u0938 \u0915\u0940 \u0916\u094b\u091c \u0907\u0938\u0940 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0924\u0940 \u0939\u0948\u0964","phone.modeHotspot":"\u092f\u0939 \u092b\u093c\u094b\u0928 \u090f\u0915 \u0905\u0938\u094d\u0925\u093e\u092f\u0940, \u0938\u093f\u0930\u094d\u092b\u093c \u0910\u092a \u0915\u0947 \u0932\u093f\u090f \u0939\u0949\u091f\u0938\u094d\u092a\u0949\u091f \u091a\u093e\u0932\u0942 \u0915\u0930\u0924\u093e \u0939\u0948\u0964 \u0926\u0942\u0938\u0930\u093e \u092b\u093c\u094b\u0928 QR \u0915\u094b\u0921 \u0938\u094d\u0915\u0948\u0928 \u0915\u0930\u0915\u0947 \u091c\u0941\u0921\u093c\u0924\u093e \u0939\u0948, \u091c\u093f\u0938\u092e\u0947\u0902 \u0928\u093e\u092e \u0914\u0930 \u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u0939\u094b\u0924\u093e \u0939\u0948\u0964 \u0907\u0902\u091f\u0930\u0928\u0947\u091f \u0915\u0947 \u092c\u093f\u0928\u093e \u0915\u093e\u092e \u0915\u0930\u0924\u093e \u0939\u0948; Wi-Fi Direct \u0909\u092a\u0932\u092c\u094d\u0927 \u0928 \u0939\u094b \u0924\u094b \u0907\u0938\u0947 \u091a\u0941\u0928\u0947\u0902\u0964","phone.modeLan":"\u0915\u0941\u091b