932 \u0921\u0947\u091f\u093e \u091a\u0932\u0924\u093e \u0939\u0948\u0964","settings.aboutP3":"\u090f\u0915 \u0939\u0940 Wi-Fi \u092f\u093e PC \u0915\u0947 \u0939\u0949\u091f\u0938\u094d\u092a\u0949\u091f \u092a\u0930 \u0932\u094b\u0915\u0932 \u0928\u0947\u091f\u0935\u0930\u094d\u0915 \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u0930\u0947\u0902\u0964 PC \u0915\u0947 \u0928\u0947\u091f\u0935\u0930\u094d\u0915 \u0938\u0947 \u091c\u0941\u0921\u093c\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f Wi-Fi QR \u0938\u094d\u0915\u0948\u0928 \u0915\u0930\u0947\u0902, \u092b\u093f\u0930 Share QR \u0938\u094d\u0915\u0948\u0928 \u0915\u0930\u0947\u0902 \u092f\u093e \u0932\u094b\u0915\u0932 \u0932\u093f\u0902\u0915 \u092a\u0947\u0938\u094d\u091f \u0915\u0930\u0947\u0902\u0964","settings.aboutP4":"\u0905\u0917\u0930 \u0936\u0947\u092f\u0930 \u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u0938\u0947 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0939\u0948, \u0924\u094b \u0909\u0938\u0947 \u092b\u093c\u094b\u0928 \u092a\u0930 \u0905\u0928\u0932\u0949\u0915 \u0915\u0930\u0947\u0902, \u092b\u093c\u093e\u0907\u0932 \u0938\u0942\u091a\u0940 \u0926\u0947\u0916\u0947\u0902 \u0914\u0930 \u092b\u093c\u093e\u0907\u0932\u0947\u0902 \u0905\u092a\u0928\u0947 Filora \u092b\u093c\u094b\u0932\u094d\u0921\u0930 \u092e\u0947\u0902 \u0938\u0947\u0935 \u0915\u0930\u0947\u0902\u0964 \u0932\u093e\u0907\u091f \u0914\u0930 \u0921\u093e\u0930\u094d\u0915 \u0925\u0940\u092e, \u0915\u0928\u0947\u0915\u094d\u0936\u0928 \u0939\u093f\u0938\u094d\u091f\u094d\u0930\u0940 \u0914\u0930 \u0905\u0928\u0941\u092e\u0924\u093f\u092f\u094b\u0902 \u0915\u0947 \u0935\u093f\u0915\u0932\u094d\u092a \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938 \u092e\u0947\u0902 \u0939\u0948\u0902\u0964","settings.aboutP5":"\u0907\u0938\u0915\u0947 \u0932\u093f\u090f \u0906\u092a\u0915\u0947 Windows PC \u092a\u0930 Filora \u091a\u093e\u0932\u0942 \u0939\u094b\u0928\u093e \u091a\u093e\u0939\u093f\u090f \u0914\u0930 \u0936\u0947\u